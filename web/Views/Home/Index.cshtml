@model List<entity.Concrate.Ilan>
@{

	var courseImages = new List<string>
	{
		"/templates(son)/assets/images/course-01.jpg",
		"/templates(son)/assets/images/course-02.jpg",
		"/templates(son)/assets/images/course-03.jpg",
		"/templates(son)/assets/images/course-04.jpg"
	};
	var images = new List<(string src, string alt)>
	{
		("~/templates(son)/assets/images/meeting-01.jpg", "New Lecturer Meeting"),
		("~/templates(son)/assets/images/meeting-02.jpg", "Online Teaching"),
		("~/templates(son)/assets/images/meeting-03.jpg", "Higher Education"),
		("~/templates(son)/assets/images/meeting-04.jpg", "Student Training"),
	};
	var random = new Random();
	ViewData["Title"] = "Anasayfa";
	Layout = "~/Views/Shared/_HomeLayout.cshtml";
}


<section class="section main-banner" id="top" data-section="section1">
	<video autoplay muted loop id="bg-video">
		<source src="@(Url.Content("~/templates(son)/assets/images/kou.mp4"))" type="video/mp4" />
	</video>


	<div class="video-overlay header-text">
		<div class="container">
			<div class="row">
				<div class="col-lg-12">
					<div class="caption">
						<h6>Merhaba Aday!</h6>
						<h2>KOCAELİ ÜNİVERSİTESİ'NE HOŞ GELDİN</h2>
						<p>
							Bu site, Kocaeli Üniversitesi’nin akademik personel alım ilanlarını
							duyurmak ve başvuru sürecini kolaylaştırmak amacıyla hazırlanmıştır.
						</p>
						<div class="main-button-red">
							<div><a href="/Login/Index">GİRİŞ YAP</a></div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<section class="services">
	<div class="container">
		<div class="row">
			<div class="col-lg-12">
				<div class="owl-service-item owl-carousel">

					<div class="item">
						<div class="icon">
							<img src="~/templates(son)/assets/images/service-icon-01.png" alt="">
						</div>
						<div class="down-content">
							<h4>Akademik Kadro İlanları</h4>
							<p>Kocaeli Üniversitesi'nin personel alımlarını takip edebilir, detaylara hızlıca ulaşabilirsiniz.</p>

						</div>
					</div>

					<div class="item">
						<div class="icon">
							<img src="~/templates(son)/assets/images/service-icon-02.png" alt="">
						</div>
						<div class="down-content">
							<h4>Kolay Başvuru Süreci</h4>
							<p>Başvurularınızı adım adım yönlendiren kullanıcı dostu arayüz ile işlemlerinizi kolayca tamamlayın.</p>

						</div>
					</div>

					<div class="item">
						<div class="icon">
							<img src="~/templates(son)/assets/images/service-icon-03.png" alt="">
						</div>
						<div class="down-content">
							<h4>Güncel Bilgilendirme</h4>
							<p>Tüm ilanlar ve duyurular düzenli olarak güncellenerek erişiminize sunulmaktadır.</p>
						</div>
					</div>

					<div class="item">
						<div class="icon">
							<img src="~/templates(son)/assets/images/service-icon-02.png" alt="">
						</div>
						<div class="down-content">
							<h4>Belgeler ve Şartlar</h4>
							<p>Her ilana özel başvuru koşulları ve gerekli belgeler açık şekilde listelenmiştir.</p>

						</div>
					</div>

					<div class="item">
						<div class="icon">
							<img src="~/templates(son)/assets/images/service-icon-03.png" alt="">
						</div>
						<div class="down-content">
							<h4>İletişim Desteği</h4>
							<p>Başvuru süreciyle ilgili sorularınız için iletişim bilgileri ve destek kanalları mevcuttur.</p>

						</div>
					</div>
					<div class="item">
						<div class="icon">
							<img src="~/templates(son)/assets/images/service-icon-03.png" alt="">
						</div>
						<div class="down-content">
							<h4>Mobil Uyumlu Tasarım</h4>
							<p>Web sitemiz mobil cihazlarla uyumlu olarak tasarlanmıştır; her yerden kolay erişim sağlar.</p>

						</div>
					</div>

				</div>
			</div>
		</div>
	</div>
</section>

<section class="upcoming-meetings" id="meetings">
	<div class="container">
		<div class="row">
			<div class="col-lg-12">
				<div class="section-heading">
					<h2>AKTİF İLANLAR</h2>
				</div>
			</div>
			<div class="col-lg-4">
				<div class="categories">
					<h4>İlan Kategorileri</h4>
					<ul>
						<li><a href="#">Akademik Personel</a></li>
						<br />
						<li><a href="#">Araştırma Görevlisi</a></li>
						<br />
						<li><a href="#">Öğretim Görevlisi</a></li>
						<br />
						<li><a href="#">Eğitim Desteği</a></li>
						<br />
						<li><a href="#">Yönetim İlanları</a></li>
						<br />
					</ul>
					<div class="main-button-red">
						<a href="/Ilanlar/Index">Tüm İlanlar</a> <!-- İlanlar sayfasına yönlendiriyoruz -->
					</div>
				</div>
			</div>

			<div class="col-lg-8">
				<div class="row">
					@foreach (var ilan in Model.Take(4))
					{
						var randomImage = images[random.Next(images.Count)];
						<div class="col-lg-6">
							<div class="meeting-item">
								<div class="thumb">
									<a href="#">
										<img src="@Url.Content(randomImage.src)" alt="@randomImage.alt" />
									</a>
								</div>
								<div class="down-content">
									<a href="#"><h4>@ilan.Baslik</h4></a>

									<div class="date">
										<h6>@ilan.Tarih.ToString("MMM") <span>@ilan.Tarih.Day</span></h6>
									</div>
									<p>@ilan.Aciklama</p>
								</div>
							</div>
						</div>
					}
				</div>
			</div>
		</div>
	</div>
</section>

<section class="apply-now" id="apply">
	<div class="container">
		<div class="row">
			<div class="col-lg-6 align-self-center">
				<div class="row">
					<div class="col-lg-12">
						<div class="item">
							<h3>AKADEMİK PERSONEL BAŞVURULARI</h3>
							<p>Akademik personel giriş sayfasına hoş geldiniz. Lütfen kurumsal bilgilerinizle giriş yaparak sisteme erişim sağlayınız.</p>
							<div class="main-button-red">
								<div class="scroll-to-section"><a href="#contact">GİRİŞ YAP</a></div>
							</div>
						</div>
					</div>
					<div class="col-lg-12">
						<div class="item">
							<h3>KAYDOLUN PROFİLİNİZİ OLUŞTURUN</h3>
							<p>Yeni bir akademik hesap oluşturmak için kayıt formunu doldurunuz. Bilgileriniz onaylandıktan sonra sisteme erişebilirsiniz.</p>							<div class="main-button-yellow">
								<div class="scroll-to-section"><a href="#contact">KAYDOL</a></div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="col-lg-6">
				<div class="accordions is-first-expanded">
					<article class="accordion">
						<div class="accordion-head">
							<span>Akademik Başvuru Sistemi Nedir?</span>
							<span class="icon">
								<i class="icon fa fa-chevron-right"></i>
							</span>
						</div>
						<div class="accordion-body">
							<div class="content">
								<br />
								<p>
									Akademik Başvuru Sistemi, öğretim elemanı adaylarının başvuru süreçlerini çevrim içi olarak yönetmelerini sağlar. Kullanıcılar burada başvuru yapabilir, belgelerini yükleyebilir ve süreçlerini takip edebilirler.
								</p>
							</div>
						</div>
					</article>

					<article class="accordion">
						<div class="accordion-head">
							<span>Başvuru İçin Gerekli Şartlar Nelerdir?</span>
							<span class="icon">
								<i class="icon fa fa-chevron-right"></i>
							</span>
						</div>
						<div class="accordion-body">
							<div class="content">
								<br />
								<p>
									Başvuru yapabilmek için ilgili ilan kriterlerini sağlamanız, gerekli belgeleri eksiksiz yüklemeniz ve belirlenen başvuru süresi içinde işlemlerinizi tamamlamanız gerekmektedir. Detaylı şartlar ilanda belirtilmektedir.<br><br>
									Şartlara uymayan başvurular sistem tarafından otomatik olarak reddedilir.
								</p>
							</div>
						</div>
					</article>

					<article class="accordion">
						<div class="accordion-head">
							<span>Başvuru Sonuçları Nasıl Duyurulacak?</span>
							<span class="icon">
								<i class="icon fa fa-chevron-right"></i>
							</span>
						</div>
						<div class="accordion-body">
							<div class="content">
								<br />
								<p>
									Başvuru sonuçları sistem üzerinde duyurulacak ve adaylara e-posta yoluyla bilgilendirme yapılacaktır. Ayrıca üniversitemizin resmi internet sitesinden de sonuçlara erişebilirsiniz.<br><br>
									Sonuçlarla ilgili detaylar, ilan edilen tarihlerde açıklanacaktır.
								</p>
							</div>
						</div>
					</article>

					<article class="accordion last-accordion">
						<div class="accordion-head">
							<span>Destek ve İletişim Bilgileri</span>
							<span class="icon">
								<i class="icon fa fa-chevron-right"></i>
							</span>
						</div>
						<div class="accordion-body">
							<div class="content">
								<br />
								<p>
									Başvuru sürecinde teknik bir sorun yaşarsanız veya bilgi almak isterseniz, akademikdestek@universite.edu.tr adresine e-posta gönderebilir ya da +90 123 456 78 90 numaralı telefondan iletişime geçebilirsiniz.<br><br>
									Destek ekibimiz mesai saatleri içinde hizmet vermektedir.
								</p>
							</div>
						</div>
					</article>
				</div>

			</div>
		</div>
	</div>
</section>

<section class="our-courses" id="courses">
	<div class="container">
		<div class="row">
			<div class="col-lg-12">
				<div class="section-heading">
					<h2>AKADEMİK PERSONEL İLANLARIMIZ</h2>
				</div>
			</div>
			<div class="col-lg-12">
				<div class="owl-courses-item owl-carousel">

					@foreach (var item in Model)
					{
						var randomCourseImage = courseImages[random.Next(courseImages.Count)];
						<div class="item">
							<img src="@randomCourseImage" alt="Random Course Image">
							<div class="down-content">
								<h4>@item.Baslik</h4>
								<div class="info">
									<div class="row">
										<div class="col-12 text-center">
											<div class="main-button-red">
												<a href="#">DETAYLAR</a>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					}
				</div>
			</div>
		</div>
	</div>
</section>

<section class="our-facts">
	<div class="container">
		<div class="row">
			<div class="col-lg-6">
				<div class="row">
					<div class="col-lg-12">
						<h2>Sayılarla Kocaeli </h2>
					</div>
					<div class="col-lg-6">
						<div class="row">
							<div class="col-12">
								<div class="count-area-content percentage">
									<div class="count-digit">2679</div>
									<div class="count-title">Akademik Personel</div>
								</div>
							</div>
							<div class="col-12">
								<div class="count-area-content percentage">
									<div class="count-digit">58394</div>
									<div class="count-title">Öğrenci</div>
								</div>
							</div>
						</div>
					</div>
					<div class="col-lg-6">
						<div class="row">
							<div class="col-12">
								<div class="count-area-content percentage">
									<div class="count-digit">1817</div>
									<div class="count-title">Uluslarası Öğrenci</div>
								</div>
							</div>
							<div class="col-12">
								<div class="count-area-content">
									<div class="count-digit">19</div>
									<div class="count-title">Fakülte</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="col-lg-6 align-self-center">
				<div class="video">
					<a href="https://www.youtube.com/watch?v=ZPZQYb0wIeE&embeds_referring_euri=https%3A%2F%2Fwww.kocaeli.edu.tr%2F" target="_blank"><img src="~/templates(son)/assets/images/play-icon.png" alt=""></a>
				</div>
			</div>
		</div>
	</div>
</section>

<section class="contact-us" id="contact">
	<div class="container">
		<div class="row">
			<div class="col-lg-9 align-self-center">
				<div class="row">
					<div class="col-lg-12">
						<form id="contact" action="" method="post">
							<div class="row">
								<div class="col-lg-12">
									<h2>BİZİMLE İLETİŞİME GEÇİN</h2>
								</div>
								<div class="col-lg-3">
									<fieldset>
										<input name="name" type="text" id="name" placeholder="İSMİNİZ" required="">
									</fieldset>
								</div>
								<div class="col-lg-3">
									<fieldset>
										<input name="surname" type="text" id="name" placeholder="SOYİSMİNİZ" required="">
									</fieldset>
								</div>
								<div class="col-lg-3">
									<fieldset>
										<input name="email" type="text" id="email" pattern="[^ ]*[^ ]*" placeholder="E-POSTA ADRESİNİZ" required="">
									</fieldset>
								</div>
								<div class="col-lg-3">
									<fieldset>
										<input name="subject" type="text" id="subject" placeholder="KONU" required="">
									</fieldset>
								</div>
								<div class="col-lg-12">
									<fieldset>
										<textarea name="message" type="text" class="form-control" id="message" placeholder="İLETİNİZ" required=""></textarea>
									</fieldset>
								</div>
								<div class="col-lg-12">
									<fieldset>
										<button type="submit" id="form-submit" class="button">GÖNDER</button>
									</fieldset>
								</div>
							</div>
						</form>
					</div>
				</div>
			</div>
			<div class="col-lg-3">
				<div class="right-info">
					<ul>
						<li>
							<h6>Telefon Numaramız</h6>
							<a href="tel:+902623031000"><span>+90(262)303 10 00</span></a>
						</li>
						<li>
							<h6>E-Posta Adresimiz</h6>
							<a href="mailto:kurumsaliletisim@kocaeli.edu.tr"><span>ogrenci@kocaeli.edu.tr</span></a>
						</li>
						<li>
							<h6>Adresimiz</h6>
							<a><span>Kabaoğlu, Baki Komsuoğlu bulvarı No:515, Umuttepe, 41001 İzmit/Kocaeli</span></a>
						</li>
						<li>
							<h6>Resmi Sitemiz</h6>
							<a href="https://www.kocaeli.edu.tr/"><span>www.kocaeli.edu.tr</span></a>
						</li>
					</ul>
				</div>
			</div>
		</div>
	</div>
</section>