@model List<entity.Concrate.Ilan>
@{
	ViewData["Title"] = "Aktif İlanlar";
	Layout = "~/Views/Shared/_Layout.cshtml";
	var images = new List<(string src, string alt)>
	{
		("~/templates(son)/assets/images/meeting-01.jpg", "New Lecturer Meeting"),
		("~/templates(son)/assets/images/meeting-02.jpg", "Online Teaching"),
		("~/templates(son)/assets/images/meeting-03.jpg", "Higher Education"),
		("~/templates(son)/assets/images/meeting-04.jpg", "Student Training"),
	};
	var random = new Random();
}

<section class="meetings-page" id="meetings">
	<div class="container">
		<div class="row">
			<div class="col-lg-12">
				<div class="row">
					<div class="col-lg-12">
						<div class="filters">
							<ul>
								<li data-filter="*" class="active">Tüm İlanlar</li>
								<li data-filter=".imp">Yeni İlanlar</li>
								<li data-filter=".soon">Aktif İlanlar</li>
								<li data-filter=".att">Pasif İlanlar</li>
							</ul>
						</div>
					</div>
					<div class="col-lg-12">
						<div class="row grid">
							@foreach (var ilan in Model)
							{
								var randomImage = images[random.Next(images.Count)];
								<div class="col-lg-4 templatemo-item-col all soon">
									<div class="meeting-item">
										<div class="thumb">
											<a href="#">
												<img src="@Url.Content(randomImage.src)" alt="@randomImage.alt" />
											</a>
										</div>
										<div class="down-content">
											<a href="#"><h4>@ilan.Baslik</h4></a>

											<div class="date">
												<h6>@ilan.Tarih.ToString("MMM")  <span>@ilan.Tarih.Day</span></h6>
											</div>
											<p>@ilan.Aciklama</p>
										</div>
									</div>
								</div>								
							}



						</div>
					</div>
					<div class="col-lg-12">
						<div class="pagination">
							<ul>
								<li class="active"><a href="#">1</a></li>
								<li><a href="#">2</a></li>
								<li><a href="#">3</a></li>
								<li><a href="#"><i class="fa fa-angle-right"></i></a></li>
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>