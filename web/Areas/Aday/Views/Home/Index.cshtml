
@{
    ViewData["Title"] = "Anasayfa";
    Layout = "~/Areas/Aday/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">
	<h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Aday Paneli /</span> Anasayfa </h4>
	<hr class="my-5" />
	<div class="row">
		<!-- Total Revenue -->
		<div class="col-12 col-lg-8 order-2 order-md-3 order-lg-2 mb-4">
			<div class="card">

				<!-- Striped Rows -->
				<div class="card">
					<h5 class="card-header"><i class="menu-icon tf-icons bx bx-news"></i>Aktif İlanlar</h5>
					<div class="table-responsive text-nowrap">
						<table style="text-align:center" class="table table-striped">
							<thead>
								<tr>
									<th>BAŞLIK</th>
									<th>DETAYLAR</th>
								</tr>
							</thead>
							<tbody class="table-border-bottom-0">
								@foreach (var satir in ViewBag.Ilanlar)
								{
									<tr>
										<td><i class="fab fa-angular fa-lg text-danger me-3"></i> <strong>@satir.Baslik</strong></td>
										<td>
											<button class="btn btn-primary" onclick="showPopup('@satir.Aciklama?.Replace("'", "\\'")')">Görüntüle</button>
										</td>
									</tr>
								}
							
							</tbody>
						</table>
					</div>
				</div>
				<!--/ Striped Rows -->
			</div>
		</div>
		<!--/ Total Revenue -->
		<div class="col-md-6 col-lg-4 order-2 mb-4">
			<div class="card h-100">
				<div class="card-header d-flex align-items-center justify-content-between">
					<h5 class="card-title m-0 me-2"><i class="menu-icon tf-icons bx bx-history"></i>Başvurularım</h5>
					<div class="dropdown">
						<button class="btn p-0"
								type="button"
								id="transactionID"
								data-bs-toggle="dropdown"
								aria-haspopup="true"
								aria-expanded="false">
							<i class="bx bx-dots-vertical-rounded"></i>
						</button>
						<div class="dropdown-menu dropdown-menu-end" aria-labelledby="transactionID">
							<a class="dropdown-item" href="~/Company/Ilan/Index">Kullanıcı gözü</a>
							<a class="dropdown-item" href="~/Admin/Ilan/Index">Düzenle</a>
						</div>
					</div>
				</div>
				<div class="card-body">
					<ul class="p-0 m-0">
						@foreach (var ilan in ViewBag.Basvurular)
						{
							<li class="d-flex mb-4 pb-1">
								<div class="d-flex w-100 flex-wrap align-items-center justify-content-between gap-2">
									<div class="me-2">
										<a href="~/Admin/Ilan/Index">
											<h6 class="mb-0">@ilan.Ilan.Baslik</h6>
										</a>
									</div>
									<div class="user-progress d-flex align-items-center gap-1">
										<span class="text-muted">@ilan.Ilan.Tarih.ToString("dd MMM yyyy")</span>
									</div>
								</div>
							</li>
						}
					</ul>
				</div>
			</div>
		</div>
	</div>
</div>


<!-- İlan Açıklama Modalı -->
<div class="modal fade" id="ilanModal" tabindex="-1" aria-labelledby="ilanModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="ilanModalLabel">İlan Detayı</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
			</div>
			<div class="modal-body" id="ilanAciklama">
				<!-- Açıklama buraya gelecek -->
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-primary" data-bs-dismiss="modal">Kapat</button>
			</div>
		</div>
	</div>
</div>

<script>
	function showPopup(aciklama) {
		document.getElementById("ilanAciklama").innerText = aciklama;
		var myModal = new bootstrap.Modal(document.getElementById('ilanModal'));
		myModal.show();
	}
</script>
