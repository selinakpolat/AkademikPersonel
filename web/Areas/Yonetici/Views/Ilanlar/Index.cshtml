@{
	ViewData["Title"] = "Tüm İlanlar";
	Layout = "~/Areas/Yonetici/Views/Shared/_Layout.cshtml";
}
<div class="container-xxl flex-grow-1 container-p-y">
	<h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Yönetici Paneli /</span> Tüm İlanlar </h4>
	<hr class="my-5" />

	<!-- Bordered Table -->
	<div class="card">
		<div class="card-header d-flex justify-content-between">
			<h5>İlanlar</h5>
			<!-- Yeni ilan ekleme butonu -->
			<button class="btn" data-bs-toggle="modal" data-bs-target="#addIlanModal">
				<i class="bx bx-plus-circle"></i>
			</button>
		</div>
		<div class="card-body">
			<div class="table-responsive text-nowrap">
				<table class="table table-bordered">
					<thead>
						<tr style="text-align:center">
							<th><b>BAŞLIK</b></th>
							<th><b>AÇIKLAMA</b></th>
							<th><b>TARİH</b></th>
							<th style="width: 80px;"><b>SAAT</b></th>
							<th style="width: 80px;"><b>DÜZENLE</b></th>
							<th style="width: 80px;"><b>SİL</b></th>
						</tr>
					</thead>
					<tbody>
						@foreach (var item in ViewBag.Ilanlar)
						{
							<tr style="text-align:center">
								<td><b>@item.Baslik</b></td>
								<td>
									<button class="btn btn-primary" onclick="showPopup('short', @item.Ilan_Id)">Görüntüle</button>
								</td>
								<td><b>@item.Tarih.ToString("dd-MMMM-yyyy")</b></td>
								<td><b>@item.Tarih.ToString("HH:mm")</b></td>
								<td>
									<a class="btn" onclick="editIlan(@item.Ilan_Id)">
										<i class="bx bx-edit"></i>
									</a>
								</td>
								<td>
									<a class="btn" onclick="deleteIlan(@item.Ilan_Id)">
										<i class="bx bx-trash"></i>
									</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>