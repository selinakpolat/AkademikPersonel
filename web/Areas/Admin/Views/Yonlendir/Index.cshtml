@{
	ViewData["Title"] = "Yetkiliye Yönlendir";
	Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-xxl flex-grow-1 container-p-y">
	<h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Admin Paneli /</span> Başvuruları Yetkiliye Yönlendir </h4>
	<hr class="my-5" />
	<!-- Tablo -->
	<div class="card">
		<div class="card-header d-flex justify-content-between">
			<h5>Başvurular</h5>
		</div>
		<div class="card-body">
			<div class="table-responsive text-nowrap">
				<table class="table table-bordered">
					<thead>
						<tr style="text-align:center">
							<th><b>BAŞVURULAN İLAN</b></th>
							<th><b>BAŞVURU SAHİBİ BİLGİLERİ</b></th>
							<th style="width: 80px;"><b> STATÜ</b></th>
							<th style="width: 80px;"><b>YÖNLENDİR</b></th>
							<th style="width: 80px;"><b> DÜZENLE</b></th>
							<th style="width: 80px;"><b> SİL</b></th>
						</tr>
					</thead>
					<tbody>
						@foreach (var item in ViewBag.Basvurular)
						{
							<tr style="text-align:center">

								<td>
									<button class="btn btn-primary ">
										Görüntüle
									</button>
								</td>
								<td>
									<button class="btn btn-primary ">
										Görüntüle
									</button>
								</td>
								<td>@item.BasvuruStatu?.Statu</td>

								<td>
									<a class="btn" onclick="deleteIlan(@item.Ilan_Id)">
										<i class="bx bx-right-arrow-alt"></i>
									</a>
								</td>
								<td>
									<a class="btn" onclick="deleteIlan(@item.Ilan_Id)">
										<i class="bx bx-edit"></i>
									</a>
								</td>
								<td>
									<a class="btn" onclick="deleteIlan(@item.Ilan_Id)">
										<i class="bx bx-trash"></i>
									</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>
