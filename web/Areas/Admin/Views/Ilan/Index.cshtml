@model List<entity.Concrate.Ilan>
@{
	ViewData["Title"] = "İlan Düzenle";
	Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<div class="container-xxl flex-grow-1 container-p-y">
	<h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Admin Paneli /</span> İlanları Düzenle </h4>
	<hr class="my-5" />

	<!-- Bordered Table -->
	<div class="card">
		<div class="card-header d-flex justify-content-between">
			<h5>İlanlar</h5>
			<!-- Yeni ilan ekleme butonu -->
			<button class="btn" data-bs-toggle="modal" data-bs-target="#addIlanModal">
				<i class="bx bx-plus-circle"></i>
			</button>
		</div>
		<div class="card-body">
			<div class="table-responsive text-nowrap">
				<table class="table table-bordered">
					<thead>
						<tr style="text-align:center">
							<th><b>BAŞLIK</b></th>
							<th><b>AÇIKLAMA</b></th>
							<th><b>TARİH</b></th>
							<th style="width: 80px;"><b>SAAT</b></th>
							<th style="width: 80px;"><b>DÜZENLE</b></th>
							<th style="width: 80px;"><b>SİL</b></th>
						</tr>
					</thead>
					<tbody>
						@foreach (var item in Model)
						{
							<tr style="text-align:center">
								<td><b>@item.Baslik</b></td>
								<td>
									<button class="btn btn-primary" onclick="showPopup('short', @item.Ilan_Id)">Görüntüle</button>
								</td>
								<td><b>@item.Tarih.ToString("dd-MMMM-yyyy")</b></td>
								<td><b>@item.Tarih.ToString("HH:mm")</b></td>
								<td>
									<a class="btn" onclick="editIlan(@item.Ilan_Id)">
										<i class="bx bx-edit"></i>
									</a>
								</td>
								<td>
									<a class="btn" onclick="deleteIlan(@item.Ilan_Id)">
										<i class="bx bx-trash"></i>
									</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>

	<!-- Yeni İlan Ekle Modal -->
	<div class="modal fade" id="addIlanModal" tabindex="-1" aria-labelledby="addIlanModalLabel" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="addIlanModalLabel">Yeni İlan Ekle</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<!-- İlan Ekleme Formu -->
					<form id="ilanForm" method="post" action="@Url.Action("IlanAdd", "Ilan")">
						<div class="mb-3">
							<label for="baslik" class="form-label">İlan Başlığı</label>
							<input type="text" class="form-control" id="baslik" name="Baslik" required />
						</div>
						<div class="mb-3">
							<label for="aciklama" class="form-label">İlan Açıklaması</label>
							<textarea class="form-control" id="aciklama" name="Aciklama" rows="3" required></textarea>
						</div>
						<div class="mb-3">
							<label for="tarih" class="form-label">TARİH ve Saat</label>
							<input type="datetime-local" class="form-control" id="tarih" name="Tarih" required />
						</div>
						<div class="text-center">
							<button type="submit" class="btn btn-primary"><b>İLANI KAYDET</b></button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>

	<!-- Servis Güncelleme Modalı -->
	<div class="modal fade" id="updateModal" tabindex="-1" aria-labelledby="updateModalLabel" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">İlan Güncelle</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<input type="hidden" id="editIlanId">
					<div class="mb-3">
						<label for="editBaslik" class="form-label">Başlık</label>
						<input type="text" class="form-control" id="editBaslik" placeholder="Başlık girin">
					</div>
					<div class="mb-3">
						<label for="editAciklama" class="form-label">Açıklama</label>
						<textarea class="form-control" id="editAciklama" placeholder="Kısa açıklama girin"></textarea>
					</div>
					<div class="mb-3">
						<label for="editTarih" class="form-label">Tarih</label>
						<textarea class="form-control" id="editTarih" placeholder="Tarih girin"></textarea>
					</div>
					<div class="mb-3">
						<label for="editStatus" class="form-label">Stuts</label>
						<input type="text" class="form-control" id="editStatus" placeholder="Bağlantı Adresi girin">
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
					<button type="button" class="btn btn-primary" onclick="saveEdit()">Kaydet</button>
				</div>
			</div>
		</div>
	</div>

	<!-- Popup Modal -->
	<div class="modal fade" id="popupModal" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog modal-lg">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">İlan Açıklama</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
				</div>
				<div class="modal-body" id="popupContent"></div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
				</div>
			</div>
		</div>
	</div>

	<!-- Confirm Modal -->
	<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-sm modal-dialog-centered">
			<div class="modal-content">
				<div class="modal-body" id="confirmModalMessage">Emin misiniz?</div>
				<div class="modal-footer p-2 d-flex justify-content-center">
					<button type="button" class="btn btn-success btn-sm" id="confirmYes">Evet</button>
					<button type="button" class="btn btn-danger btn-sm" id="confirmNo">Hayır</button>
				</div>
			</div>
		</div>
	</div>

	<!-- Toast Container -->
	<div id="toast-container" style="position: fixed; top: 20px; right: 20px; z-index: 9999;"></div>

	<script>
				// Toast Gösterme Fonksiyonu
		function showToast(message) {
			const toastContainer = document.getElementById('toast-container');

			const toast = document.createElement('div');
			toast.textContent = message;
			toast.style.backgroundColor = '#1e9d4b';
			toast.style.color = 'white';
			toast.style.padding = '10px 20px';
			toast.style.marginTop = '10px';
			toast.style.borderRadius = '8px';
			toast.style.boxShadow = '0 2px 6px rgba(0,0,0,0.2)';
			toast.style.fontSize = '16px';
			toast.style.opacity = '1';
			toast.style.transition = 'opacity 0.5s ease';

			toastContainer.appendChild(toast);

			// Daha uzun süre göstermek için timeout'u arttıralım (10 saniye örneği)
			const displayDuration = 10000; // 10 saniye

			setTimeout(() => {
				toast.style.opacity = '0';
				setTimeout(() => {
					toast.remove();
				}, 500); // Fade out süresi (0.5 saniye)
			}, displayDuration);
		}


		// Popup içeriğini açan fonksiyon
		function showPopup(type, ilanId) {
			fetch(`/Admin/Ilan/IlanGet/${ilanId}`)
				.then(response => response.json())
				.then(data => {
					console.log("Popup'a gelen veri:", data);
					let content = type === 'short'
						? (data.aciklama?.trim()?.length ? data.aciklama : "Kısa açıklama bulunamadı.")
						: (data.tarih?.trim()?.length ? data.tarih : "Açıklama bulunamadı.");

					openPopup(content);
				})
				.catch(error => console.error("Hata:", error));
		}

		// Popup açan yardımcı fonksiyon
		function openPopup(content) {
			const popupContent = document.getElementById("popupContent");
			popupContent.innerHTML = content;
			new bootstrap.Modal(document.getElementById("popupModal")).show();
		}

		// İlan düzenlemek için verileri çeken fonksiyon
		function editIlan(ilanId) {
			fetch(`/Admin/Ilan/IlanGet/${ilanId}`)
				.then(response => {
					if (!response.ok) {
						throw new Error("Servis bilgileri alınamadı");
					}
					return response.json();
				})
				.then(data => {
					document.getElementById("editIlanId").value = data.ilan_Id || "";
					document.getElementById("editBaslik").value = data.baslik || "";
					document.getElementById("editAciklama").value = data.aciklama || "";
					document.getElementById("editTarih").value = data.tarih || "";
					document.getElementById("editStatus").value = data.status ? "true" : "false";

					new bootstrap.Modal(document.getElementById("updateModal")).show();
				})
				.catch(error => console.error("Hata:", error));
		}

		// İlan güncelleyen fonksiyon
		function saveEdit() {
			var ilanId = document.getElementById("editIlanId").value;
			var updatedData = {
				Ilan_Id: parseInt(ilanId),
				Baslik: document.getElementById("editBaslik").value,
				Aciklama: document.getElementById("editAciklama").value,
				Tarih: document.getElementById("editTarih").value,
				Status: document.getElementById("editStatus").value === "true"
			};

			fetch(`/Admin/Ilan/IlanUpdate`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(updatedData)
			})
			.then(response => response.json())
			.then(data => {
				if (data.success) {
					showToast("İlan başarıyla güncellendi!");
					location.reload();
				} else {
					showToast("Güncelleme başarısız!");
				}
			})
			.catch(error => {
				console.error("Güncelleme Hata:", error);
				showToast("Sunucu hatası oluştu!");
			});

			var myModal = bootstrap.Modal.getInstance(document.getElementById("updateModal"));
			myModal.hide();
		}
				// İlan silen fonksiyon (confirm yerine custom confirm kullanıyor)
		function deleteIlan(ilanId) {
			showConfirm("Bu ilanı silmek istediğinizden emin misiniz?", function (result) {
				if (result) {
					fetch(`/Admin/Ilan/IlanDelete`, {
						method: 'POST',
						headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
						body: `id=${ilanId}`
					})
					.then(response => response.json())
					.then(data => {
						if (data.success) {
							showToast("İlan başarıyla silindi!");
							location.reload();
						} else {
							showToast("Silme işlemi başarısız!");
						}
					})
					.catch(error => {
						console.error('Silme Hatası:', error);
						showToast("Sunucu hatası oluştu!");
					});
				}
			});
		}


		// Add Modal açılınca form temizleme
		document.getElementById('addIlanModal')?.addEventListener('show.bs.modal', function (event) {
			document.getElementById('ilanForm')?.reset();
		});

				// Confirm Fonksiyonu
		function showConfirm(message, onConfirm) {
			const modal = new bootstrap.Modal(document.getElementById('confirmModal'));
			document.getElementById('confirmModalMessage').innerText = message;

			const yesBtn = document.getElementById('confirmYes');
			const noBtn = document.getElementById('confirmNo');

			// Önce eski event listenerları temizleyelim
			yesBtn.onclick = () => {
				onConfirm(true);
				modal.hide();
			};
			noBtn.onclick = () => {
				onConfirm(false);
				modal.hide();
			};

			modal.show();
		}


	</script>



